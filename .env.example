# ─────────────────────────────────────────────────────────────
# CaseLab — переменные окружения.
# Скопируйте этот файл в .env (для запуска на своём компьютере)
# или впишите те же строки в Render → caselab → Environment.
# Файл .env НИКОГДА не загружайте на GitHub: репозиторий публичный.
# ─────────────────────────────────────────────────────────────

# ── Сайт ──
BASE_URL=https://caselab-j12j.onrender.com
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
OWNER_STEAMID=76561199534076116
STEAM_API_KEY=

# ── Маркет ──
# скидка относительно цены Steam: 0.05 = на 5% дешевле
MARKET_DISCOUNT=0.05

# ── Пополнение баланса ──
# сумма одного пополнения в долларах баланса сайта
DEPOSIT_MIN_USD=1
DEPOSIT_MAX_USD=1000

# Банковские карты: CloudPayments (личный кабинет → Сайты → настройки сайта)
# Public ID и пароль для API. Пусто = оплата картой выключена.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# адрес API вашего договора: https://api.cloudpayments.ru (Россия)
# или адрес, который даст CloudPayments Казахстан
CLOUDPAYMENTS_API_URL=https://api.cloudpayments.ru
# валюта, в которой платит покупатель, и сколько её стоит $1 баланса
CLOUDPAYMENTS_CURRENCY=KZT
CLOUDPAYMENTS_RATE=500
# 1 = принимать тестовые платежи (тестовый Public ID); на боевом сайте 0
CLOUDPAYMENTS_TEST_MODE=0

# Криптовалюта: Trybit (бывший CryptoCloud), личный кабинет → проект → Интеграция и API
# Пусто = оплата криптовалютой выключена.
TRYBIT_API_KEY=
TRYBIT_SHOP_ID=
TRYBIT_SECRET_KEY=
TRYBIT_API_URL=https://api.trybit.com/v2
